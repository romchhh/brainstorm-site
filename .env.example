# Public site URL used for canonicals, Open Graph and sitemap.
NEXT_PUBLIC_SITE_URL=https://brainstorm.org.ua

# Admin panel (change in production!)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=brainstorm2025

# Optional: directory for SQLite CMS data (default: ./cms-data)
# CMS_DATA_DIR=./cms-data

# Optional: Google Search Console verification meta
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Geocoding event addresses for the map (Geocoding API). Without it, OSM Nominatim is used.
# GOOGLE_MAPS_API_KEY=

# CRM_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
